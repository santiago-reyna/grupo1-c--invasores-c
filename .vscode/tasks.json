{
    "version": "2.0.0",
    "tasks": [
		{
			"type": "shell",
			"label": "Compilar Invasores",
			"command": "C:/msys64/ucrt64/bin/gcc.exe",
			"args": [
				"main.c",
				"movimientos/juego.c",
				"-o",
				"juego.exe",
				"-I",
				"movimientos",
				"-I",
				"C:/msys64/ucrt64/include",
				"-L",
				"C:/msys64/ucrt64/lib",
				"-lraylib",
				"-lopengl32",
				"-lgdi32",
				"-lwinmm"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			]
		}
	]
}